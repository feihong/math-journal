{
  "manifest_version": 3,
  "name": "AoPS Review",
  "version": "1.1",
  "description": "Makes it easier to review AoPS Alcumus (and other) problems",
  "permissions": ["scripting", "activeTab"],
  "host_permissions": [
    "https://artofproblemsolving.com/alcumus/problem",
    "https://artofproblemsolving.com/alcumus/report/me",
    "https://artofproblemsolving.com/alcumus/report/me/trial/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://artofproblemsolving.com/alcumus/problem",
        "https://artofproblemsolving.com/alcumus/report/me",
        "https://artofproblemsolving.com/alcumus/report/me/trial/*"
      ],
      "js": ["content.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
