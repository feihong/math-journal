{
  "manifest_version": 3,
  "name": "AoPS Ebook Review Mode",
  "version": "1.0",
  "description": "Makes it easier to review problems you already did in AoPS online ebooks",
  "permissions": ["scripting", "activeTab"],
  "host_permissions": [
    "https://artofproblemsolving.com/ebooks/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://artofproblemsolving.com/ebooks/*"
      ],
      "js": ["content.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
